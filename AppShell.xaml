<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="ThreeSF.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ThreeSF.Views"
       Title="3SF"
       FlyoutBehavior="Locked">

    <Shell.FlyoutHeader>
        <Grid Padding="20,24,20,16">
            <HorizontalStackLayout Spacing="10">
                <Border WidthRequest="36"
                        HeightRequest="36"
                        BackgroundColor="{StaticResource Accent}"
                        StrokeThickness="0"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Label Text="3"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                    <Label Text="3SF" FontSize="16" FontAttributes="Bold" />
                    <Label Text="デスクトップアプリ" Style="{StaticResource HintText}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <VerticalStackLayout Padding="20,0,20,16" Spacing="8">
            <Button Text="テーマを切り替え"
                    Style="{StaticResource GhostButton}"
                    Clicked="OnToggleThemeClicked" />
            <Label x:Name="VersionLabel" Style="{StaticResource HintText}" Margin="4,0,0,0" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

    <ShellContent Title="ホーム"
                  Route="home"
                  ContentTemplate="{DataTemplate views:HomePage}" />

    <ShellContent Title="設定"
                  Route="settings"
                  ContentTemplate="{DataTemplate views:SettingsPage}" />

    <ShellContent Title="このアプリについて"
                  Route="about"
                  ContentTemplate="{DataTemplate views:AboutPage}" />

</Shell>
